# Copy to .env with ./scripts/gen-env.sh (generates the secrets below).
# Never commit .env.

# --- Secrets (generated) -------------------------------------------------------
# AES-256 key for provider credentials: 32 random bytes, base64.
ENCRYPTION_KEY=
# HMAC pepper for gateway API key hashes: at least 32 characters.
API_KEY_PEPPER=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- Bootstrap -----------------------------------------------------------------
# First administrator, created only when the users table is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Seed mock providers, models, prices, routing policies and a demo team.
SEED_DEMO=true
# Optional gateway key (gwk_ + 43 base64url chars) created for the demo team.
DEMO_API_KEY=

# --- Runtime -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
# Set to true behind HTTPS.
COOKIE_SECURE=false
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
TRUSTED_PROXIES=
# When Redis is down: false = reject (503), true = serve without rate limits.
RATE_LIMIT_FAIL_OPEN=false
DEFAULT_TEAM_RPM=600
DEFAULT_TEAM_CONCURRENCY=50
# Applied when a client omits max_tokens; also bounds budget reservations.
DEFAULT_MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT=120s
STREAM_TIMEOUT=10m
RESERVATION_TTL=15m
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_DURATION=30s
OTEL_SERVICE_NAME=llm-gateway

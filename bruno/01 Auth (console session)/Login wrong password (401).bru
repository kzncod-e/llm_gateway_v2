meta {
  name: Login wrong password (401)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nobody@example.com",
    "password": "definitely-wrong-password"
  }
}

tests {
  test("status 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Uses a different email so it never throttles the admin login (10 attempts/min per IP and email).
}

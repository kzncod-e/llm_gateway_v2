meta {
  name: Me
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: none
}

headers {
  Cookie: gw_session={{sessionToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("is admin", function () {
    expect(res.getBody().user.role).to.equal("admin");
  });
}

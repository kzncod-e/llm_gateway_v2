meta {
  name: Error - invalid API key (401)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: gwk_invalid
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "smart",
    "messages": [
      {
        "role": "user",
        "content": "Explain circuit breakers simply"
      }
    ],
    "max_tokens": 256
  }
}

tests {
  test("status 401", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("error code invalid_api_key", function () {
    expect(res.getBody().error.code).to.equal("invalid_api_key");
  });
}

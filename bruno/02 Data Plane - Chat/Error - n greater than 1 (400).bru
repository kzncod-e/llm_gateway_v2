  token: {{apiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "smart",
    "messages": [
      {
        "role": "user",
        "content": "Explain circuit breakers simply"
      }
    ],
    "max_tokens": 256,
    "n": 2
  }
}

tests {
  test("status 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

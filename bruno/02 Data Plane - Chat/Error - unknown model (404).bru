meta {
  name: Error - unknown model (404)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "no-such-model",
    "messages": [
      {
        "role": "user",
        "content": "Explain circuit breakers simply"
      }
    ],
    "max_tokens": 256
  }
}

tests {
  test("status 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("error code model_not_found", function () {
    expect(res.getBody().error.code).to.equal("model_not_found");
  });
}

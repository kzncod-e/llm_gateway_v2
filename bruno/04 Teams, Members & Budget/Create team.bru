meta {
  name: Create team
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/teams
  body: json
  auth: none
}

headers {
  Cookie: gw_session={{sessionToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno Team {{ts}}",
    "slug": "bruno-{{ts}}",
    "description": "Created by the Bruno collection"
  }
}

script:post-response {
  bru.setVar("teamId", res.getBody().id);
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

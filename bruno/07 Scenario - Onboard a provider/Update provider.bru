meta {
  name: Update provider
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/providers/{{providerId}}
  body: json
  auth: none
}

headers {
  Cookie: gw_session={{sessionToken}}
  Content-Type: application/json
}

body:json {
  {
    "priority": 40,
    "timeout_ms": 20000
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

meta {
  name: Breakdown by team
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/analytics/breakdown?from={{dateFrom}}&to={{dateTo}}&by=team
  body: none
  auth: none
}

params:query {
  from: {{dateFrom}}
  to: {{dateTo}}
  by: team
}

headers {
  Cookie: gw_session={{sessionToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

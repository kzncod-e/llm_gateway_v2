meta {
  name: Create team with rpm_limit 1
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/teams
  body: json
  auth: none
}

headers {
  Cookie: gw_session={{sessionToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno RPM {{ts}}",
    "slug": "bruno-rpm-{{ts}}",
    "rpm_limit": 1
  }
}

script:post-response {
  bru.setVar("rpmTeamId", res.getBody().id);
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

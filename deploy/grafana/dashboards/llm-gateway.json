    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Request rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(rate(llm_gateway_requests_total[5m]))",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#BBA98C",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Success ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(rate(llm_gateway_requests_total{status=\"success\"}[5m])) / clamp_min(sum(rate(llm_gateway_requests_total{status!=\"rate_limited\"}[5m])),1e-9)",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#C97A6B",
        "value": null
       },
       {
        "color": "#D8B26A",
        "value": 0.9
       },
       {
        "color": "#8FAE84",
        "value": 0.98
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "id": 3
  },
